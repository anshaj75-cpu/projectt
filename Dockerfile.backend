# ---------- FastAPI backend ----------
FROM python:3.11-slim AS base
WORKDIR /app

# Install OS deps needed by ffmpeg, yt-dlp, etc.
RUN apt-get update && apt-get install -y \
    ffmpeg \
    wget \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps (pin versions you already use)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy app source (adjust path if needed)
COPY . .

# Expose the API port
EXPOSE 8000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]